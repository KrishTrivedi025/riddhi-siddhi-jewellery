# Copy this file to `.env` and fill in your own values.

# Postgres connection (Supabase project connection strings)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Auth.js (NextAuth) JWT signing secret — generate with `npx auth secret`
AUTH_SECRET=

# Supabase project (public anon key — safe for client exposure per Supabase docs)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# GST verification API (optional — used by lib/actions/gst.ts; app falls back gracefully if unset)
GST_API_KEY=
GST_API_KEY_FALLBACK=
